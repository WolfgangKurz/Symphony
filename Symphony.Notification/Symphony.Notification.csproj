<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Symphony.Notification</RootNamespace>
    <AssemblyName>Symphony.Notification</AssemblyName>
    <ApplicationIcon>lao_launcher.ico</ApplicationIcon>
    <NoWin32Manifest>true</NoWin32Manifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <Prefer32Bit>true</Prefer32Bit>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <Target Name="EmbedManagedDependencies"
          AfterTargets="ResolveReferences"
          BeforeTargets="CreateManifestResourceNames">
    <ItemGroup>
      <_EmbeddedToolkitDependency Include="@(ReferencePath)"
                                  Condition="'%(Filename)%(Extension)' == 'Microsoft.Toolkit.Uwp.Notifications.dll'" />
      <_SystemValueTupleReference Include="@(ReferencePath)"
                                  Condition="'%(Filename)%(Extension)' == 'System.ValueTuple.dll'" />
      <_EmbeddedValueTupleDependency Include="$(NuGetPackageRoot)\system.valuetuple\%(_SystemValueTupleReference.NuGetPackageVersion)\lib\net47\System.ValueTuple.dll"
                                     Condition="'@(_SystemValueTupleReference)' != '' and Exists('$(NuGetPackageRoot)\system.valuetuple\%(_SystemValueTupleReference.NuGetPackageVersion)\lib\net47\System.ValueTuple.dll')" />
      <_EmbeddedDependency Include="@(_EmbeddedToolkitDependency);@(_EmbeddedValueTupleDependency)" />

      <EmbeddedResource Include="@(_EmbeddedDependency)">
        <LogicalName>Symphony.Notification.Dependencies/%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <Error Condition="'@(_EmbeddedToolkitDependency)' == ''"
           Text="Microsoft.Toolkit.Uwp.Notifications.dll was not resolved for embedding." />
    <Error Condition="'@(_EmbeddedValueTupleDependency)' == ''"
           Text="The runtime System.ValueTuple.dll was not resolved for embedding." />
    <Message Importance="High"
             Text="[EmbedManagedDependencies] Embedding dependency: %(_EmbeddedDependency.Filename)%(_EmbeddedDependency.Extension)"
             Condition="'@(_EmbeddedDependency)' != ''" />
  </Target>

</Project>
